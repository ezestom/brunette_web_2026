---
import Layout from "../../layouts/Layout.astro";
import ProductDetail from "../../components/ProductDetail";
import ReferenceProduct from "../../components/reference/ReferenceProduct.astro";
import { getPublicContent } from "../../lib/content";
import { MENU_SECTIONS } from "../../data/menu";
const content = getPublicContent();
const menuProduct = content.menuProducts?.find(
  (p) => p.slug === Astro.params.slug,
);
const product =
  content.products.find((p) => p.slug === Astro.params.slug) || menuProduct;
if (!product) return Astro.redirect("/catalogo");
const menuSection =
  menuProduct &&
  MENU_SECTIONS.find(
    (section) => `carta-${section.id}` === menuProduct.category,
  );
const related = menuProduct ? content.menuProducts || [] : content.products;
---

<Layout
  content={content}
  title={product.name}
  description={product.description}
>
  <section class="Section Product_Page_Section SectionPadded">
    <a
      class="back-link Grow_Anim"
      href={menuSection ? `/carta?seccion=${menuSection.id}` : "/catalogo"}
    >
      {menuSection ? "← Volver a la carta" : "← Volver a los antojos"}
    </a>
    <ProductDetail
      product={product}
      currency={content.settings.currency}
      formatLabel={
        menuSection
          ? `${menuSection.name} · ${product.variants[0].name}`
          : undefined
      }
      client:load
    />
  </section>
  <section class="Section SectionPadded">
    <h2 class="SectionTitle RecommendedTitle Cool_Text_Anim Lines">
      Un antojo más.
    </h2>
    <div class="Collection_Product_List">
      {related
        .filter((p) => p.id !== product.id && p.category === product.category)
        .slice(0, 3)
        .map((p) => (
          <div class="Collection_Product">
            <ReferenceProduct
              product={p}
              currency={content.settings.currency}
            />
          </div>
        ))}
    </div>
  </section>
</Layout>
