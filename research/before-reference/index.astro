---
import Layout from "../layouts/Layout.astro";
import Catalog from "../components/Catalog";
import { getPublicContent } from "../lib/content";
const content = getPublicContent();
const { home, settings, categories, products } = content;
---

<Layout content={content} hero>
  <section class="hero">
    <img
      class="hero-image"
      src={home.heroImage}
      alt="Selección de tortas y preparaciones dulces"
      width="1920"
      height="1393"
      fetchpriority="high"
    />
    <div class="hero-shade"></div>
    <div class="hero-topline">
      <span>{settings.tagline}</span>
      <span>Hecho para disfrutar</span>
    </div>
    <div class="hero-bottom">
      <h1>{home.heroTitle}</h1>
      <a href="#antojos" class="hero-sticker">
        Se me
        <br />
        antoja <span>↘</span>
      </a>
    </div>
    <div class="hero-caption">
      <p>{home.heroSubtitle}</p>
      <a href="#intro" aria-label="Seguir explorando">
        ↓
      </a>
    </div>
  </section>
  {home.showAnnouncement && (
    <div class="announcement">
      <span>✳</span>
      <p>{home.announcement}</p>
      <span>✳</span>
    </div>
  )}
  <section class="intro section-pad" id="intro">
    <h2 data-reveal>{home.introTitle}</h2>
    <div data-reveal>
      <p>{home.introText}</p>
      <a class="text-link" href="/sucursales">
        Encontrá tu Brunette <span>↗</span>
      </a>
    </div>
    <span class="intro-flower" aria-hidden="true">
      ✳
    </span>
  </section>
  <section class="featured-section section-pad" id="antojos">
    <div class="section-heading" data-reveal>
      <p class="eyebrow">Una selección irresistible</p>
      <h2>
        Los favoritos
        <br />
        del mostrador<span>✳</span>
      </h2>
      <a href="/catalogo" class="text-link">
        Ver todos los antojos ↗
      </a>
    </div>
    <Catalog
      products={products.filter((p) => p.featured).slice(0, 6)}
      categories={categories}
      currency={settings.currency}
      client:load
    />
  </section>
  <div class="marquee" aria-hidden="true">
    <div>
      {Array.from({ length: 6 }, () => (
        <span>
          Un antojo lleva a otro <i>✳</i>
        </span>
      ))}
    </div>
  </div>
  <section class="category-section section-pad">
    <div class="section-heading centered" data-reveal>
      <p class="eyebrow">Algo rico, a tu manera</p>
      <h2>¿Cuál es tu antojo?</h2>
    </div>
    <div class="category-grid">
      {categories.map((category, i) => (
        <a
          href={`/catalogo?categoria=${category.id}`}
          class:list={["category-card", i % 2 === 1 && "alternate"]}
          data-reveal
        >
          <div class="category-image">
            <img
              src={category.image}
              alt={category.name}
              width="700"
              height="850"
              loading="lazy"
            />
          </div>
          <div>
            <h3>{category.name}</h3>
            <p>{category.description}</p>
            <span class="category-arrow">↗</span>
          </div>
        </a>
      ))}
    </div>
  </section>
  <section class="story-section section-pad">
    <div class="story-image" data-reveal>
      <img
        src={home.storyImage}
        alt="Preparaciones del mostrador"
        width="800"
        height="1000"
        loading="lazy"
      />
      <span>
        Mucho amor.
        <br />
        Mucho antojo.
      </span>
    </div>
    <div class="story-copy" data-reveal>
      <p class="eyebrow">Esto es Brunette</p>
      <h2>{home.storyTitle}</h2>
      <p>{home.storyText}</p>
      <a href="/nosotros" class="pill outline">
        Conocenos <span>↗</span>
      </a>
    </div>
  </section>
  <section class="how-section section-pad">
    <p class="eyebrow">Del mostrador a tu mesa</p>
    <h2>
      Tres pasos.
      <br />
      Un final muy rico.
    </h2>
    <div class="how-grid">
      <article>
        <span>01</span>
        <h3>Elegí tu antojo</h3>
        <p>
          Explorá el catálogo y sumá tus favoritos. Para ocasiones especiales,
          mirá las opciones por encargo.
        </p>
      </article>
      <article>
        <span>02</span>
        <h3>Contanos tu plan</h3>
        <p>
          Elegí sucursal, retiro o entrega y la fecha que necesitás. Te
          mostramos la anticipación de cada producto.
        </p>
      </article>
      <article>
        <span>03</span>
        <h3>Lo coordinamos</h3>
        <p>
          Prepará tu consulta y enviala por WhatsApp. Confirmamos
          disponibilidad, horario y forma de pago.
        </p>
      </article>
    </div>
  </section>
</Layout>
