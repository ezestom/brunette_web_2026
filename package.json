{
  "name": "brunette-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "astro check && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4322",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.ts",
    "backup": "node --env-file-if-exists=.env scripts/backup.ts",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "@astrojs/react": "7.1.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^5.9.3"
  }
}
